# --- Base ---
DATABASE_URL=postgresql://usuario:clave@localhost:5432/proveedor_regional
# Mínimo 32 caracteres aleatorios (también firma los códigos de verificación de correo)
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
PORT=5000
APP_BASE_URL=https://www.sicr3p.cl
# development solo en tu máquina; en el servidor, production (sin esto el sistema rechaza
# los secretos de prueba y no imprime correos en consola).
NODE_ENV=production
# 1 solo si nginx corre en el MISMO servidor delante de Node (se confía en X-Forwarded-For
# únicamente desde loopback). Si Node atiende Internet directo, dejar vacío.
TRUST_PROXY=

# --- Pago Flow ---
FLOW_API_KEY=
FLOW_SECRET_KEY=
# sandbox | production
FLOW_ENV=sandbox

# --- Preinscripción ---
# Firma HMAC del QR de la tarjeta (mínimo 32 caracteres). Si cambia, los QR ya emitidos dejan de validar.
CARD_SIGNING_SECRET=
# Vigencia de la tarjeta de preinscripción en meses (por defecto 12)
PREINSCRIPCION_VIGENCIA_MESES=12
# Documentos KYC: SIEMPRE fuera de la carpeta pública y del repositorio
UPLOAD_DIR=/var/lib/sicrep/kyc

# --- Correo (código de verificación y avisos) ---
# sicr3p.cl tiene el correo en DonWeb (MX mail.sicr3p.cl). Cuenta: soporte@sicr3p.cl
SMTP_HOST=mail.sicr3p.cl
SMTP_PORT=465
# true = SSL directo (465); false = STARTTLS (587). Vacío: se deduce del puerto.
SMTP_SECURE=
SMTP_USER=soporte@sicr3p.cl
SMTP_PASS=
MAIL_FROM="Proveedor Regional <soporte@sicr3p.cl>"

# --- Apple Wallet (certificado Pass Type ID) — PEM en línea o ruta a archivo ---
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_PEM=/etc/sicrep/wallet/AppleWWDRCAG4.pem
APPLE_SIGNER_CERT_PEM=/etc/sicrep/wallet/pass-cert.pem
APPLE_SIGNER_KEY_PEM=/etc/sicrep/wallet/pass-key.pem
APPLE_SIGNER_KEY_PASSPHRASE=

# --- Google Wallet (cuenta de servicio con acceso al emisor) ---
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=/etc/sicrep/wallet/google-sa-key.pem
