# Copia este archivo como .env y completa los valores.

# Dominio público, sin https:// (debe apuntar a la IP del VPS)
DOMINIO=proveedorregional.cl

# Contraseña de la base de datos (larga y aleatoria)
DB_PASSWORD=

# Secreto para firmar sesiones. Genera uno con: openssl rand -hex 32
JWT_SECRET=

# Administrador inicial (se crea solo la primera vez, si no hay usuarios)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Fundación Entretodos
